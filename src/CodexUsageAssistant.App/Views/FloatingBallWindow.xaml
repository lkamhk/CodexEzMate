<Window x:Class="CodexUsageAssistant.Views.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CodexUsageAssistant.Converters"
        Title="Codex EzMate v1.21.0" Icon="pack://application:,,,/Assets/CodexUsageAssistant.ico"
        Width="72" Height="72" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize">
  <Window.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <Grid MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseMove="OnMouseMove">
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" />
        <MenuItem Header="{DynamicResource LoginUsage}" Command="{Binding LoginCommand}"
                  Visibility="{Binding ShowDomLoginMenu, Converter={StaticResource BoolToVisibility}}" />
        <Separator />
        <MenuItem Header="{DynamicResource GoalMonitorTab}" Command="{Binding OpenGoalMonitorCommand}" />
        <MenuItem Header="{DynamicResource HostTab}" Command="{Binding OpenServerHostCommand}" />
        <MenuItem Header="{DynamicResource RunAutomation}" Command="{Binding RunAutomationCommand}" />
        <Separator />
        <MenuItem Header="{DynamicResource HotkeySettings}" Command="{Binding OpenHotkeySettingsCommand}" />
        <Separator />
        <MenuItem Header="{DynamicResource Settings}" Command="{Binding OpenSettingsCommand}" />
        <MenuItem Header="{DynamicResource Exit}" Command="{Binding ExitCommand}" />
      </ContextMenu>
    </Grid.ContextMenu>

    <Border x:Name="Ball" Width="72" Height="72" CornerRadius="36"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="#F2F6F1" BorderBrush="#B8D7E6" BorderThickness="1">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding PrimaryLimitLabel}" Foreground="#51829B" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding PrimaryLimitPercent}" Foreground="#243B49" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Margin="80,0,0,0" Width="280" Height="310" CornerRadius="18"
            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="#E4EEF4" BorderBrush="#C7DBE5" BorderThickness="1">
      <StackPanel Margin="12">
        <TextBlock Text="Codex EzMate" Foreground="#243B49" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource FiveHourRemaining}" Foreground="#667E8A" Margin="0,5,0,1" />
        <ProgressBar Value="{Binding FiveHourValue}" Maximum="100" Height="7" Foreground="#73B4D1" Background="#D7E4EB" />
        <TextBlock Text="{Binding FiveHourPercent}" Foreground="#243B49" FontSize="12" HorizontalAlignment="Right" />
        <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource ResetLabel}" Foreground="#667E8A" FontSize="10" /><TextBlock Text="{Binding FiveHourResetDisplay}" Foreground="#667E8A" FontSize="10" /></StackPanel>
        <TextBlock Text="{DynamicResource WeeklyRemaining}" Foreground="#667E8A" Margin="0,2,0,1" />
        <ProgressBar Value="{Binding WeeklyValue}" Maximum="100" Height="7" Foreground="#73B4D1" Background="#D7E4EB" />
        <TextBlock Text="{Binding WeeklyPercent}" Foreground="#243B49" FontSize="12" HorizontalAlignment="Right" />
        <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource ResetLabel}" Foreground="#667E8A" FontSize="10" /><TextBlock Text="{Binding WeeklyResetDisplay}" Foreground="#667E8A" FontSize="10" /></StackPanel>
        <Border Margin="0,5,0,2" Padding="7,5" CornerRadius="7" Background="#D5E7EF">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="{DynamicResource AvailableUsageReset}" Foreground="#667E8A" FontSize="10" />
              <TextBlock Text="{Binding AvailableUsageResetDisplay}" Foreground="#3783A3" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </DockPanel>
            <TextBlock Text="{Binding UsageResetExpiresDisplay}" Foreground="#667E8A" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <DockPanel Margin="0,3,0,0">
          <TextBlock Text="{DynamicResource LastUpdated}" Foreground="#718690" FontSize="10" />
          <TextBlock Text="{Binding LastUpdated}" Foreground="#536E7E" FontSize="10" HorizontalAlignment="Right" />
        </DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#718690" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataSourceDisplay}" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" Height="22" Padding="5,0" />
          <Button Content="{DynamicResource Automation}" Command="{Binding RunAutomationCommand}" Height="22" Padding="5,0" Margin="4,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
