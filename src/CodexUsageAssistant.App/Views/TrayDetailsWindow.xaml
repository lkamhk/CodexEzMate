<Window x:Class="CodexUsageAssistant.Views.TrayDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TrayDetailsTitle}" Width="390" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#202D35" FontFamily="Segoe UI" FontSize="13"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Deactivated="OnDeactivated">
  <Window.Resources>
    <Geometry x:Key="CreditIcon">M13.5 11C13.2239 11 13 11.2239 13 11.5C13 11.7761 13.2239 12 13.5 12H14.5C14.7761 12 15 11.7761 15 11.5C15 11.2239 14.7761 11 14.5 11H13.5ZM3 4.5C3 3.67157 3.67157 3 4.5 3H14C15.1046 3 16 3.89543 16 5V5.26756C16.5978 5.61337 17 6.25972 17 7V15C17 16.1046 16.1046 17 15 17H5.5C4.11929 17 3 15.8807 3 14.5V4.5ZM14 4H4.5C4.22386 4 4 4.22386 4 4.5C4 4.77614 4.22386 5 4.5 5H15C15 4.44772 14.5523 4 14 4ZM4.5 6C4.32468 6 4.15639 5.96992 4 5.91465V14.5C4 15.3284 4.67157 16 5.5 16H15C15.5523 16 16 15.5523 16 15V7C16 6.44772 15.5523 6 15 6H4.5Z</Geometry>
    <Geometry x:Key="TokenIcon">M10 10C9.72386 10 9.5 10.2239 9.5 10.5V13.5C9.5 13.7761 9.72386 14 10 14C10.2761 14 10.5 13.7761 10.5 13.5V10.5C10.5 10.2239 10.2761 10 10 10ZM6 8.5C6 8.22386 6.22386 8 6.5 8C6.77614 8 7 8.22386 7 8.5V13.5C7 13.7761 6.77614 14 6.5 14C6.22386 14 6 13.7761 6 13.5V8.5ZM13.5 6C13.2239 6 13 6.22386 13 6.5V13.5C13 13.7761 13.2239 14 13.5 14C13.7761 14 14 13.7761 14 13.5V6.5C14 6.22386 13.7761 6 13.5 6ZM3 5C3 3.89543 3.89543 3 5 3H15C16.1046 3 17 3.89543 17 5V15C17 16.1046 16.1046 17 15 17H5C3.89543 17 3 16.1046 3 15V5ZM4 5V15C4 15.5523 4.44772 16 5 16H15C15.5523 16 16 15.5523 16 15V5C16 4.44772 15.5523 4 15 4H5C4.44772 4 4 4.44772 4 5Z</Geometry>
    <Geometry x:Key="ResetIcon">M16 10C16 6.68629 13.3137 4 10 4C8.2234 4 6.62683 4.77191 5.52772 6H7.5C7.77614 6 8 6.22386 8 6.5C8 6.77614 7.77614 7 7.5 7H4.5C4.22386 7 4 6.77614 4 6.5V3.5C4 3.22386 4.22386 3 4.5 3C4.77614 3 5 3.22386 5 3.5V5.10109C6.27012 3.80499 8.04094 3 10 3C13.866 3 17 6.13401 17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 9.8191 3.00687 9.6397 3.02038 9.46207C3.04133 9.18673 3.28152 8.98049 3.55687 9.00144C3.83222 9.02239 4.03845 9.26258 4.0175 9.53793C4.00591 9.69034 4 9.84443 4 10C4 13.3137 6.68629 16 10 16C13.3137 16 16 13.3137 16 10Z</Geometry>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#334953" />
      <Setter Property="BorderBrush" Value="#C9DCE5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D3E6EF" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#BED9E8" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="0,10,0,10" />
      <Setter Property="Background" Value="#DFE9EE" />
      <Setter Property="Foreground" Value="#70B7D4" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track">
            <Border Background="{TemplateBinding Background}" CornerRadius="5" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5" />
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Margin="5" Padding="22,20,22,16" CornerRadius="19" BorderBrush="#D0DFE7" BorderThickness="1">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
      <GradientStop Color="#F2F6F1" Offset="0" /><GradientStop Color="#DEEAF2" Offset="1" />
    </LinearGradientBrush></Border.Background>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown" Margin="0,0,0,18">
        <Button DockPanel.Dock="Right" Content="×" FontSize="21" Click="OnCloseClick" ToolTip="{DynamicResource HideDetails}" VerticalAlignment="Top" />
        <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Command="{Binding RefreshCommand}"
                ToolTip="{DynamicResource Refresh}" AutomationProperties.Name="{DynamicResource Refresh}" VerticalAlignment="Top" />
        <StackPanel><TextBlock Text="Codex Usage" FontSize="23" FontWeight="Bold" />

        </StackPanel>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Height="1" Background="#D6E2E6" Margin="0,0,0,18" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource WeeklyRemaining}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          <Grid x:Name="PlanBadge" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" ClipToBounds="True" IsVisibleChanged="OnPlanVisibilityChanged" Loaded="OnPlanLoaded" Unloaded="OnPlanUnloaded" SizeChanged="OnPlanSizeChanged">
            <TextBlock x:Name="PlanText" Text="{Binding PlanDisplay}" Foreground="#8B650D" FontWeight="Light" FontSize="14" />
            <Canvas IsHitTestVisible="False">
              <Canvas.OpacityMask><VisualBrush Visual="{Binding ElementName=PlanText}" Stretch="Fill"/></Canvas.OpacityMask>
              <Rectangle Width="28" Height="90" Fill="#FFF9DA">
                <Rectangle.RenderTransform><TransformGroup>
                  <RotateTransform Angle="45"/>
                  <TranslateTransform x:Name="PlanSweep" X="-80" Y="-35"/>
                </TransformGroup></Rectangle.RenderTransform>
              </Rectangle>
            </Canvas>
          </Grid>
          </Grid>
          <DockPanel Margin="0,12,0,0"><TextBlock Text="{Binding WeeklyPercent}" DockPanel.Dock="Right" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="{DynamicResource QuotaRemaining}" Foreground="#536872" VerticalAlignment="Center" /></DockPanel>
          <ProgressBar Value="{Binding WeeklyValue}" Maximum="100" />
          <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource ResetLabel}" Foreground="#74848C" FontSize="11" />
            <TextBlock Text="{Binding WeeklyResetDisplay}" Foreground="#74848C" FontSize="11" /></StackPanel>
          <TextBlock Text="{DynamicResource FiveHourRemaining}" FontSize="16" FontWeight="Bold" Margin="0,21,0,0" />
          <DockPanel Margin="0,12,0,0"><TextBlock Text="{Binding FiveHourPercent}" DockPanel.Dock="Right" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="{DynamicResource QuotaRemaining}" Foreground="#536872" VerticalAlignment="Center" /></DockPanel>
          <ProgressBar Value="{Binding FiveHourValue}" Foreground="#73AADD" Maximum="100" />
          <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource ResetLabel}" Foreground="#74848C" FontSize="11" />
            <TextBlock Text="{Binding FiveHourResetDisplay}" Foreground="#74848C" FontSize="11" /></StackPanel>
          <Border Height="1" Background="#D6E2E6" Margin="0,20,0,18" />
          <Grid x:Name="CarouselArea" Background="Transparent" MouseEnter="OnCarouselMouseChanged" MouseLeave="OnCarouselMouseChanged" IsKeyboardFocusWithinChanged="OnCarouselFocusChanged">
          <TabControl x:Name="DetailsContentTabs" SelectedIndex="{Binding SelectedDetailsTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="25,0" Focusable="False">
            <TabControl.Template>
              <ControlTemplate TargetType="TabControl">
                <StackPanel>
                  <ContentPresenter Content="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Margin="-25,0,0,12"/>
                  <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                </StackPanel>
              </ControlTemplate>
            </TabControl.Template>
            <TabItem>
              <TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ResetIcon}" Fill="#3C849F" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource AvailableUsageReset}" FontWeight="Bold"/></StackPanel></TabItem.Header>
              <StackPanel MinHeight="125">
                <DockPanel><Button Content="{DynamicResource UseReset}" Click="OnUseResetClick" IsEnabled="{Binding CanUseReset}" ToolTip="{Binding ResetAvailabilityHint}" ToolTipService.ShowOnDisabled="True" DockPanel.Dock="Right" Background="#D3E6EF" Padding="9,4"/>
                  <TextBlock Text="{Binding AvailableUsageResetDisplay}" Foreground="#3C849F" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <TextBlock Text="{Binding UsageResetExpiresDisplay}" Foreground="#637984" FontSize="12" LineHeight="23" TextWrapping="Wrap" Margin="0,10,0,16" />
              </StackPanel>
            </TabItem>
            <TabItem>
              <TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource TokenIcon}" Fill="#3C849F" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Token"/></StackPanel></TabItem.Header>
              <StackPanel MinHeight="145">
                <ItemsControl x:Name="TokenChart" ItemsSource="{Binding DailyTokenRows}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Height="145" ToolTip="{Binding Tooltip}" Margin="3,0">
                      <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="100"/><RowDefinition Height="23"/></Grid.RowDefinitions>
                      <TextBlock Text="{Binding CountLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                      <Border Grid.Row="1" Width="22" Background="#DFE9EE" CornerRadius="4">
                        <Border Height="{Binding Percent}" VerticalAlignment="Bottom" Background="#70B7D4" CornerRadius="4"/>
                      </Border>
                      <TextBlock Grid.Row="2" Text="{Binding DateLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource LocalTokenNotice}" Foreground="#74848C" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0">
                  <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasLocalTokenEstimate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{DynamicResource TokenNoHistory}" Foreground="#74848C" TextWrapping="Wrap" Margin="0,10">
                  <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding DailyTokenRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style></TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </TabItem>
            <TabItem>
              <TabItem.Header><StackPanel Orientation="Horizontal"><Path Data="{StaticResource CreditIcon}" Fill="#3C849F" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Credit"/></StackPanel></TabItem.Header>
              <StackPanel MinHeight="125">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource CreditBalance}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource CreditAvailable}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="2" Text="{DynamicResource CreditUnlimited}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding CreditBalanceDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding CreditAvailableDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CreditUnlimitedDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock Text="{DynamicResource CreditHelp}" Foreground="#74848C" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </TabItem>
          </TabControl>
          <Button x:Name="PreviousDetailsButton" Content="&#x276E;" Command="{Binding PreviousDetailsCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="23" Padding="2,10" Opacity="0" IsHitTestVisible="False" ToolTip="{DynamicResource PreviousDetails}" AutomationProperties.Name="{DynamicResource PreviousDetails}"/>
          <Button x:Name="NextDetailsButton" Content="&#x276F;" Command="{Binding NextDetailsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="23" Padding="2,10" Opacity="0" IsHitTestVisible="False" ToolTip="{DynamicResource NextDetails}" AutomationProperties.Name="{DynamicResource NextDetails}"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2">
        <Border Height="1" Background="#D6E2E6" Margin="0,5,0,8" />
        <DockPanel Margin="0,4,0,0"><Button Content="{DynamicResource Exit}" Command="{Binding ExitCommand}" DockPanel.Dock="Right" Padding="8,5" />
          <Button x:Name="FooterSettingsButton" Content="{DynamicResource Settings}" Command="{Binding OpenSettingsCommand}" DockPanel.Dock="Right" Padding="8,5" Margin="0,0,4,0" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource LastUpdated}" Foreground="#819198" FontSize="11" Margin="0,0,6,0" />
            <TextBlock Text="{Binding LastUpdated}" Foreground="#819198" FontSize="11" /></StackPanel>
        </DockPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
