<Window x:Class="CodexUsageAssistant.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Icon="pack://application:,,,/CodexEzMate;component/Assets/CodexUsageAssistant.ico"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#EAF1F5" Foreground="#243B49">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/CodexEzMate;component/Resources/SettingsStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Image Width="76" Height="76" Margin="0,0,14,0" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Source><BitmapImage UriSource="/CodexEzMate;component/Assets/CodexUsageAssistant-preview.png" DecodePixelWidth="152" CacheOption="OnLoad"/></Image.Source>
      </Image>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Codex EzMate" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource SettingsTitle}" Foreground="#718690" Margin="0,5,0,0"/>
      </StackPanel>
    </DockPanel>
    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,16,0,0">
      <Button Content="{DynamicResource Cancel}" Click="OnCancelClick" Padding="16,7" Margin="8,0,0,0" DockPanel.Dock="Right" />
      <Button Content="{DynamicResource Save}" Click="OnSaveClick" Padding="20,7" Margin="8,0,0,0" DockPanel.Dock="Right" />
    </DockPanel>
    <TabControl Background="#EAF1F5">
      <TabItem x:Name="BasicSettingsTabItem" Header="{DynamicResource BasicSettings}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
          <TextBlock Text="{DynamicResource BasicSettings}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
          <CheckBox x:Name="ServerNotificationCheckBox" Content="{DynamicResource ServerNotificationRefresh}" Margin="0,0,0,8"/>
          <TextBlock Text="{DynamicResource ServerNotificationHelp}" Foreground="#718690" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource AutoRefreshInterval}" VerticalAlignment="Center" />
            <TextBox x:Name="AutoRefreshMinutesTextBox" Grid.Column="1" Height="32" Padding="8,5" />
            <TextBlock Grid.Column="2" Text="{DynamicResource MinutesDisabledHelp}" Foreground="#718690" VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>
          <CheckBox x:Name="TrayUsageCheckBox" Content="{DynamicResource TrayUsageIcon}" Margin="0,16,0,0"/>
          <CheckBox x:Name="AutoUpdateCheckBox" Content="{DynamicResource AutoCheckUpdates}" Margin="0,12,0,0"/>

        <StackPanel Margin="0,20,0,0">
          <TextBlock Text="{DynamicResource UsageSourceTitle}" FontSize="20" FontWeight="SemiBold" />
          <RadioButton x:Name="AppServerFallbackRadio" GroupName="UsageSource" Content="{DynamicResource AppServerFallback}" Margin="0,20,0,10" />
          <RadioButton x:Name="AppServerOnlyRadio" GroupName="UsageSource" Content="{DynamicResource AppServerOnly}" Margin="0,0,0,10" />
          <RadioButton x:Name="DomOnlyRadio" GroupName="UsageSource" Content="{DynamicResource DomOnly}" Margin="0,0,0,20" />
          <TextBlock Text="{DynamicResource CodexExecutable}" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBox x:Name="CodexExecutableTextBox" Height="32" Padding="8,5" />
          <TextBlock Text="{DynamicResource UsageSourceHelp}" Foreground="#718690" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource DisplayTab}">
        <StackPanel Margin="18">
          <TextBlock Text="{DynamicResource DisplayModeTitle}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource DisplayModeDescription}"
                     Foreground="#718690" TextWrapping="Wrap" Margin="0,8,0,16" />
          <RadioButton x:Name="FloatingBallModeRadio" GroupName="DisplayMode" Margin="0,7">
            <TextBlock Text="{DynamicResource FloatingOnly}" Foreground="#243B49" />
          </RadioButton>
          <RadioButton x:Name="SystemTrayModeRadio" GroupName="DisplayMode" Margin="0,7">
            <TextBlock Text="{DynamicResource TrayOnly}" Foreground="#243B49" />
          </RadioButton>
          <RadioButton x:Name="BothModeRadio" GroupName="DisplayMode" Margin="0,7">
            <TextBlock Text="{DynamicResource BothModes}" Foreground="#243B49" />
          </RadioButton>
          <TextBlock Text="{DynamicResource TrayHelp}" Foreground="#397C9D" TextWrapping="Wrap" Margin="0,16,0,0" />
          <TextBlock Text="{DynamicResource Language}" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6" />
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ChineseLanguageRadio" GroupName="Language" Margin="0,5,22,5">
              <TextBlock Text="{DynamicResource ChineseLanguage}" Foreground="#243B49" />
            </RadioButton>
            <RadioButton x:Name="EnglishLanguageRadio" GroupName="Language" Margin="0,5">
              <TextBlock Text="{DynamicResource EnglishLanguage}" Foreground="#243B49" />
            </RadioButton>
            <RadioButton x:Name="SimplifiedLanguageRadio" GroupName="Language" Content="简体中文" Margin="22,5,0,5" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="{DynamicResource ProxyTab}">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource ProxyTitle}" FontSize="20" FontWeight="SemiBold" />
          <CheckBox x:Name="ProxyEnabledCheckBox" Grid.Row="1" Content="{DynamicResource EnableProxy}" FontSize="14" Margin="0,12,0,8" />
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ProxyAddress}" VerticalAlignment="Center" />
            <TextBox x:Name="ProxyServerTextBox" Grid.Column="1" Height="32" Padding="8,5" ToolTip="例如 socks5://127.0.0.1:7890" />
          </Grid>
          <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Bypass List" VerticalAlignment="Center" />
            <TextBox x:Name="BypassTextBox" Grid.Column="1" Height="32" Padding="8,5" />
          </Grid>
          <TextBlock Grid.Row="4" Text="{DynamicResource ProxyAuthHelp}" Foreground="#718690" Margin="0,14,0,8" />
          <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ProxyUsername}" VerticalAlignment="Center" />
            <TextBox x:Name="ProxyUsernameTextBox" Grid.Column="1" Height="32" Padding="8,5" />
          </Grid>
          <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ProxyPassword}" VerticalAlignment="Center" />
            <PasswordBox x:Name="ProxyPasswordBox" Grid.Column="1" Height="32" Padding="8,5" />
          </Grid>
          <StackPanel Grid.Row="8" Margin="0,14,0,0">
            <Button x:Name="TestButton" Content="{DynamicResource TestConnection}" Click="OnTestClick" HorizontalAlignment="Left" Padding="16,7" />
            <TextBlock x:Name="TestStatusText" Text="{DynamicResource NotTested}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <ProgressBar x:Name="TestProgress" Height="3" Margin="0,10,0,0" Visibility="Collapsed" IsIndeterminate="True" />
          </StackPanel>
        </Grid>
      </TabItem>


    </TabControl>
  </DockPanel>
</Window>
