<Window x:Class="CodexUsageAssistant.Views.ResetWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CodexUsageAssistant.Models"
        Title="{DynamicResource ResetWatchTitle}" Width="800" Height="660" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="#EDF3F6" Foreground="#223B47" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/><Setter Property="MinHeight" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#244C5C"/><Setter Property="BorderBrush" Value="#CDDCE3"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#327D99"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#244C5C"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="SourceLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#326879"/><Setter Property="Padding" Value="0,3"/>
      <Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="12,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#223B47"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="Underline" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="#617783"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="#244C5C"/>
            <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold"/>
            <Setter TargetName="Underline" Property="BorderBrush" Value="#327D99"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Underline" Property="Background" Value="#E0ECF1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CAD9E1"/>
      <Setter Property="Foreground" Value="#223B47"/><Setter Property="Background" Value="White"/>
    </Style>
  </Window.Resources>
  <Grid Margin="28,24,28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="{DynamicResource ResetWatchHeading}" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource ResetWatchIntro}" Margin="0,5,0,0" Foreground="#617783" FontSize="13"/>
    </StackPanel>
    <TabControl x:Name="ResetTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
      <TabItem x:Name="ActivityTab" Header="{DynamicResource ResetWatchActivity}">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button Grid.Row="2" Content="Data from Codex Resets ↗" Style="{StaticResource SourceLink}" HorizontalAlignment="Left"
                  Visibility="{Binding TrackerAttributionVisibility}" Command="{Binding OpenLinkCommand}" CommandParameter="https://codex-resets.com"/>
          <Grid x:Name="ActivityToolbar" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse Width="7" Height="7" Margin="0,6,10,0" VerticalAlignment="Top">
                <Ellipse.Style><Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="#7B909A"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusTone}" Value="healthy"><Setter Property="Fill" Value="#2D806B"/></DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="warning"><Setter Property="Fill" Value="#A77521"/></DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="error"><Setter Property="Fill" Value="#B04D45"/></DataTrigger>
                  </Style.Triggers>
                </Style></Ellipse.Style>
              </Ellipse>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="FeedStatusText" Text="{Binding Status}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource OptionalText}" FontSize="12" Foreground="#617783" Margin="0,3,0,0">
                  <TextBlock.ToolTip><ToolTip MaxWidth="500"><TextBlock Text="{Binding SourceDetails}"/></ToolTip></TextBlock.ToolTip>
                </TextBlock>
              </StackPanel>
            </Grid>
            <Button x:Name="RefreshFeedButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                    Command="{Binding CheckNowCommand}" IsEnabled="{Binding CanCheck}" VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource ResetWatchCheck}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource ResetWatchCheck}"/>
              </StackPanel>
            </Button>
          </Grid>
          <ScrollViewer x:Name="ActivityScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
              <Border Visibility="{Binding EmptyVisibility}" Background="White" BorderBrush="#DAE5EB" BorderThickness="1" CornerRadius="12" Padding="28,40">
                <StackPanel>
                  <TextBlock Text="{DynamicResource ResetWatchEmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource ResetWatchEmpty}" Foreground="#617783" FontSize="13" Margin="0,8,0,0" TextAlignment="Center"/>
                </StackPanel>
              </Border>
              <ItemsControl x:Name="EventList" ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Background="White" BorderBrush="#DAE5EB" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Published}" ToolTip="{Binding PublishedDetails}" Foreground="#617783" FontSize="12" Margin="12,0,0,0"/>
                        <WrapPanel>
                          <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Margin="0,0,12,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Setter Property="Foreground" Value="#2D7967"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusCode}" Value="{x:Static models:ResetAnnouncementStatus.Preview}"><Setter Property="Foreground" Value="#94641D"/></DataTrigger>
                                <DataTrigger Binding="{Binding StatusCode}" Value="{x:Static models:ResetAnnouncementStatus.Corrected}"><Setter Property="Foreground" Value="#376FA0"/></DataTrigger>
                                <DataTrigger Binding="{Binding StatusCode}" Value="{x:Static models:ResetAnnouncementStatus.Retracted}"><Setter Property="Foreground" Value="#AF4A43"/></DataTrigger>
                              </Style.Triggers>
                            </Style></TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding Category}" Style="{StaticResource OptionalText}" FontSize="12" Foreground="#617783"/>
                        </WrapPanel>
                      </DockPanel>
                      <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource OptionalText}" Margin="0,10,0,0" Foreground="#425E6B"/>
                      <TextBlock Text="{Binding Timing}" Style="{StaticResource OptionalText}" Margin="0,10,0,0"/>
                      <TextBlock Text="{Binding Scope}" Style="{StaticResource OptionalText}" Margin="0,6,0,0" Foreground="#425E6B"/>
                      <TextBlock Text="{Binding Warning}" Style="{StaticResource OptionalText}" Margin="0,10,0,0" FontSize="12" Foreground="#94641D"/>
                      <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding Links}" Margin="0,0,12,0">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource SourceLink}" Margin="0,0,16,0"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Url}" ToolTip="{Binding Url}" AutomationProperties.Name="{Binding Label}">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" MaxWidth="260"/>
                                <TextBlock Text="↗" Margin="6,0,0,0"/>
                              </StackPanel>
                            </Button>
                          </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="1" Text="{Binding Evidence}" ToolTip="{DynamicResource ResetWatchEvidenceHint}"
                                   MaxWidth="200" VerticalAlignment="Center" Foreground="#617783" FontSize="12"/>
                      </Grid>
                      <Expander Header="{DynamicResource ResetWatchDetails}" IsExpanded="{Binding DetailsExpanded, Mode=TwoWay}"
                                Visibility="{Binding HasDetails, Converter={StaticResource VisibleWhenTrue}}" FontSize="12" Margin="0,10,0,0" Foreground="#617783">
                        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="#F4F8FA"
                                 MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="{DynamicResource ResetWatchDetails}"/>
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource ResetWatchSettings}" x:Name="FeedSettingsTab">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="FeedSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Border Background="White" BorderBrush="#DAE5EB" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,8,0">
            <StackPanel IsEnabled="{Binding CanEdit}">
              <CheckBox Content="{DynamicResource ResetWatchEnable}" IsChecked="{Binding Enabled}" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource ResetWatchUrl}" Margin="0,14,0,6" FontSize="13"/>
              <TextBox x:Name="FeedUrlBox" Text="{Binding FeedUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048"
                       AutomationProperties.Name="{DynamicResource ResetWatchUrl}"/>
              <TextBlock Text="{DynamicResource ResetWatchTrust}" FontSize="12" Foreground="#617783" Margin="0,7,0,16"/>
              <WrapPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource ResetWatchInterval}" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="13"/>
                <TextBox Text="{Binding PollMinutes, UpdateSourceTrigger=PropertyChanged}" Width="64" MaxLength="2"
                         AutomationProperties.Name="{DynamicResource ResetWatchInterval}"/>
              </WrapPanel>
              <Border Height="1" Background="#E6EDF1" Margin="0,0,0,18"/>
              <TextBlock Text="{DynamicResource ResetWatchNotices}" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <CheckBox Content="{DynamicResource ResetWatchPreviews}" IsChecked="{Binding NotifyPreviews}"/>
              <CheckBox Content="{DynamicResource ResetWatchAnnouncements}" IsChecked="{Binding NotifyAnnouncements}"/>
              <CheckBox Content="{DynamicResource ResetWatchCommunity}" IsChecked="{Binding NotifyCommunity}"/>
              <CheckBox Content="{DynamicResource ResetWatchPopup}" IsChecked="{Binding ShowPopup}"/>
              <StackPanel Margin="24,0,0,6" IsEnabled="{Binding ShowPopup}">
                <TextBlock Text="{DynamicResource ResetWatchPopupKeepOpen}" FontSize="12" Foreground="#617783" Margin="0,0,0,4"/>
                <WrapPanel>
                  <CheckBox Content="{DynamicResource ResetWatchPopupAutoClose}" IsChecked="{Binding PopupAutoClose}" Margin="0,5,10,5"/>
                  <TextBox Text="{Binding PopupAutoCloseSeconds, UpdateSourceTrigger=PropertyChanged}" Width="72" MaxLength="4"
                           IsEnabled="{Binding PopupAutoClose}" AutomationProperties.Name="{DynamicResource ResetWatchPopupAutoClose}"/>
                  <TextBlock Text="{DynamicResource ResetWatchPopupSeconds}" VerticalAlignment="Center" Margin="8,0,0,0"
                             Foreground="#617783" IsEnabled="{Binding PopupAutoClose}"/>
                </WrapPanel>
              </StackPanel>
              <CheckBox Content="{DynamicResource ResetWatchAccountNotices}" IsChecked="{Binding NotifyAccountChanges}"/>
              <Expander Header="{DynamicResource ResetWatchPrivacyHeading}" FontSize="12" Foreground="#617783" Margin="0,14,0,18">
                <TextBlock Text="{DynamicResource ResetWatchPrivacy}" Margin="0,10,0,0"/>
              </Expander>
            </StackPanel>
          </Border>
        </ScrollViewer>
          <Button x:Name="SaveFeedButton" Grid.Row="1" Content="{DynamicResource ResetWatchSave}" Style="{StaticResource PrimaryButton}"
                  Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Right" Margin="0,12,8,0"/>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="{Binding Message}" Style="{StaticResource OptionalText}" Foreground="#94641D" FontSize="13" Margin="0,0,0,7"/>
      <TextBlock Text="{DynamicResource ResetWatchAccountHint}" FontSize="11" Foreground="#617783"/>
    </StackPanel>
  </Grid>
</Window>
