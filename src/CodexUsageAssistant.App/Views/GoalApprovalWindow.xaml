<Window x:Class="CodexUsageAssistant.Views.GoalApprovalWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="760" Height="600" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterScreen" Background="#EAF1F5" Foreground="#243B49">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/CodexEzMate;component/Resources/SettingsStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="20" Background="#EAF1F5">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="ContextText" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBox x:Name="DetailsText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
  <ScrollViewer Grid.Row="2" MaxHeight="220" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="QuestionsPanel" Margin="0,12,0,0"/></ScrollViewer>
  <StackPanel x:Name="DecisionsPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"/>
 </Grid>
</Window>
