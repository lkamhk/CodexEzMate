<Window x:Class="CodexUsageAssistant.Views.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex EzMate v1.21.3" Width="560" Height="440" WindowStartupLocation="CenterScreen" Background="#EAF1F5" Foreground="#243B49">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,15"/>
  <TextBox x:Name="NotesText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F8FBFC" BorderThickness="0" Padding="12"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button x:Name="CheckButton" Click="OnCheck" Padding="12,7" Margin="0,0,8,0"/>
   <Button x:Name="InstallButton" Click="OnInstall" Padding="12,7" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="CloseButton" Click="OnClose" Padding="12,7"/>
  </StackPanel>
 </Grid>
</Window>
