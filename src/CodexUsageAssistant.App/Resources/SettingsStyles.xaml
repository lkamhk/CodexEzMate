<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#243B49" />
      <Setter Property="CaretBrush" Value="#243B49" />
      <Setter Property="BorderBrush" Value="#BCD0DC" />
      <Setter Property="SelectionBrush" Value="#2962A8" />
      <Setter Property="SelectionTextBrush" Value="#243B49" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#243B49" />
      <Setter Property="BorderBrush" Value="#BCD0DC" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#DCEAF1" />
      <Setter Property="Foreground" Value="#243B49" />
      <Setter Property="BorderBrush" Value="#BBD0DD" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#243B49" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#243B49" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Background" Value="#E4EEF3" />
      <Setter Property="Foreground" Value="#243B49" />
      <Setter Property="BorderBrush" Value="#CFDDE5" />
      <Setter Property="Padding" Value="14,7" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#D6E8F1" />
          <Setter Property="Foreground" Value="#243B49" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#BBDCEC" />
          <Setter Property="Foreground" Value="#243B49" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#F8FBFC" />
      <Setter Property="Foreground" Value="#243B49" />
      <Setter Property="BorderBrush" Value="#CFDDE5" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#DCE7EC" />
      <Setter Property="RowBackground" Value="#F8FBFC" />
      <Setter Property="AlternatingRowBackground" Value="#EDF4F7" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#DCEAF1" />
      <Setter Property="Foreground" Value="#243B49" />
      <Setter Property="BorderBrush" Value="#CFDDE5" />
    </Style>

</ResourceDictionary>
