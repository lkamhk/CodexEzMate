<Window x:Class="CodexUsageAssistant.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource LoginTitle}" Icon="pack://application:,,,/Assets/CodexUsageAssistant.ico"
        Width="1000" Height="720"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#3A3A3A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#727272" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#111111" />
      <Setter Property="CaretBrush" Value="#111111" />
      <Setter Property="BorderBrush" Value="#8A8A8A" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#202123" Padding="10">
      <StackPanel>
        <DockPanel LastChildFill="False">
          <Button Content="{DynamicResource ReadCurrentUsage}" Click="OnReadUsageClick" DockPanel.Dock="Right" Padding="14,6" />
          <Button Content="{DynamicResource Go}" Click="OnGoClick" DockPanel.Dock="Right" Padding="14,6" Margin="0,0,8,0" />
          <TextBox x:Name="AddressTextBox" DockPanel.Dock="Left" Width="650" Height="30" Padding="8,4"
                   VerticalContentAlignment="Center" KeyDown="OnAddressKeyDown" />
        </DockPanel>
        <TextBlock x:Name="StatusText" Text="{DynamicResource InitializingLogin}" Foreground="White" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <wv2:WebView2 x:Name="Browser" />
  </DockPanel>
</Window>
