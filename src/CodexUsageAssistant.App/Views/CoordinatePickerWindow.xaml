<Window x:Class="CodexUsageAssistant.Views.CoordinatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PickerTitle}" Icon="pack://application:,,,/Assets/CodexUsageAssistant.ico"
        WindowStyle="None" AllowsTransparency="True" Background="#12000000"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Cursor="Cross"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        KeyDown="OnKeyDown">
  <Grid>
    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
            Padding="18,11" CornerRadius="9" Background="#F21D1D1D"
            BorderBrush="#7A7A7A" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="{DynamicResource PickerInstruction}"
                   Foreground="White" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource PickerCancelHelp}"
                   Foreground="#C8C8C8" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
